# Puerto interno del backend (Nginx hará proxy hacia este puerto)
PORT=3001

# Dominio público permitido por CORS (puedes poner varios separados por coma)
# Ejemplo:
# ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
ALLOWED_ORIGINS=https://tu-dominio.com

# API key de Groq (obligatoria)
GROQ_API_KEY=tu_api_key_aqui
