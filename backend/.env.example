# Copia este fichero a .env y rellena la clave.
# Consíguela gratis en https://aistudio.google.com/apikey

GEMINI_API_KEY=
PORT=3001
# URL del frontend en producción (opcional)
FRONTEND_URL=

# ── Modelo de IA ──────────────────────────────────────────────────────
# Para cambiar de modelo basta con editar AI_MODEL y reiniciar el backend.
# No hay que tocar código: el servicio habla el formato de OpenAI y toma de
# aquí a dónde apunta, con qué clave y con qué modelo.
#
# Modo directo contra Gemini (el de por defecto). Valores para AI_MODEL:
#   gemini-flash-lite-latest   el más rápido y barato
#   gemini-3.5-flash           equilibrado
#   gemini-3.6-flash           el más capaz
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash
AI_REASONING_EFFORT=low
# Si no se define AI_API_KEY se usa GEMINI_API_KEY.

# Modo LiteLLM (arranca el proxy con: docker compose up -d).
# Descomenta estas tres y comenta las dos de arriba. AI_MODEL pasa a ser un
# alias de litellm_config.yaml: rapido | equilibrado | calidad
# AI_BASE_URL=http://localhost:4000/v1
# AI_MODEL=equilibrado
# AI_API_KEY=sk-local-redactor-ia

# Clave del proxy LiteLLM (solo local, no es un secreto de proveedor)
LITELLM_MASTER_KEY=sk-local-redactor-ia
